# ──────────────────────────────────────────────────────────────────────────────
#  PrepMate AI - Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="PrepMate AI"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Option A: Path to service account JSON file (local dev)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# Option B: Inline JSON string (recommended for Render/Railway)
# Paste the entire service account JSON as a single-line string
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/prepmate_uploads
MAX_UPLOAD_SIZE_MB=50

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── CORS - Comma-separated list of allowed origins ────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app
