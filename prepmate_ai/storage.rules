rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // PDFs — only owner can read/write
    match /pdfs/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024  // 50 MB max
        && (request.resource.contentType == 'application/pdf'
            || resource.contentType == 'application/pdf');
    }

    // Avatars — only owner can read/write
    match /avatars/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024   // 5 MB max
        && request.resource.contentType.matches('image/.*');
    }
  }
}
